<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="komowai-pu" transaction-type="JTA">
        <jta-data-source>jdbc/DefaultDataSource</jta-data-source>
        <class>dukes.UserProfile</class>
        <class>dukes.Experience</class>
        <class>dukes.Skill</class>
        <class>dukes.Project</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
